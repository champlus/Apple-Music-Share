<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    >
    <application android:label="乐拾" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name="cn.cham.lyricsreceiver.MainActivity" android:exported="true"
            android:launchMode="singleTop" android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.instagram.share.ADD_TO_STORY" />
                <action android:name="com.facebook.stories.ADD_TO_STORY" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <provider android:name="cn.cham.lyricsreceiver.ImageProvider"
            android:authorities="com.instagram.android.lyrics.files" android:exported="false"
            android:grantUriPermissions="true">
            <grant-uri-permission android:pathPrefix="/images/" />
        </provider>
    </application>
</manifest>
